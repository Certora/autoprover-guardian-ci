{
  "name": "autoprover-guardian-ci",
  "version": "2.0.0",
  "description": "AutoProver Guardian CI GitHub Action for AI Auditor, AutoProver, and AutoFuzzer pull-request workflows",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
    "security",
    "audit",
    "ai-auditor",
    "auto-prover",
    "auto-fuzzer"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
