{
  "name": "zeus-guardian-ci",
  "version": "2.0.0",
  "description": "Certora v2 GitHub Action for AI Auditor, AutoProver, and AutoFoundry pull-request workflows",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-action",
